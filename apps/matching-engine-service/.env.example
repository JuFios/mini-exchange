PORT=3001
DATABASE_HOST=exchange-db
DATABASE_PORT=5432
DATABASE_USER=engine
DATABASE_PASSWORD=engine-local-only
DATABASE_NAME=exchange
REDIS_HOST=redis
REDIS_PORT=6379
# Публічні значення для локального запуску. Для віддаленого запуску задайте власні секрети.
JWT_ACCESS_SECRET=demo-access-secret-local-only-00000001
JWT_REFRESH_SECRET=demo-refresh-secret-local-only-0000002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_REUSE_GRACE_MS=10000
# Лише ASCII-адреси через кому; IDN-домен записують у punycode.
ADMIN_EMAILS=admin@demo.local
ADMIN_PASSWORD=demo-admin-local-only
INSTANCE_ID=engine-1
INSTRUMENTS=ABC,XYZ

ENGINE_WORKER_ENABLED=true
# Резерви працюють разом із consumer settlement. Увімкнення на історії без резервів відхиляється при старті.
RESERVATIONS_ENABLED=true
SETTLEMENT_URL=http://settlement-service:3002
INTERNAL_API_TOKEN=demo-internal-token-local-only-00000001
RESERVATION_TIMEOUT_MS=2000
RESERVATION_SWEEP_AFTER_MS=60000
RESERVATION_SWEEP_INTERVAL_MS=1000
COMMAND_POLL_INTERVAL_MS=200
OUTBOX_POLL_INTERVAL_MS=100
STREAM_MAXLEN=1000000
ORDER_SYNC_WAIT_MS=1500
SEQ_GAP_ALERT_MS=5000
# Скільки репліка може не просуватися за seq, перш ніж /ready поверне 503 і сокети буде розірвано.
# Якщо змінну не задано, діє 5000.
WS_REPLICA_MAX_LAG_MS=5000

LEASE_TTL_MS=5000

LEASE_RENEW_INTERVAL_MS=1500
LEASE_SAFETY_MS=500
ACQUIRE_INTERVAL_MS=1000
CHAOS_ENABLED=false
CHAOS_STALL_BEFORE_COMMIT_MS=60000
