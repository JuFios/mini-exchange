{
  "name": "frontend",
  "version": "0.1.0",
  "description": "Web client of the exchange",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,lib,tests}/**/*.{ts,tsx}\" middleware.ts next.config.js app/globals.css",
    "format:check": "prettier --check \"{app,lib,tests}/**/*.{ts,tsx}\" middleware.ts next.config.js app/globals.css",
    "test": "tsc -p tsconfig.test.json && node --test node_modules/.cache/book-session-test/tests/*.test.js"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "next": { "postcss": "^8.5.32" }
  }
}
